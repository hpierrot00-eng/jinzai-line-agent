PORT=8787
PUBLIC_BASE_URL=https://your-domain.example

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
DEFAULT_CLIENT_ID=00000000-0000-0000-0000-000000000001

# Slack approval UI
SLACK_BOT_TOKEN=xoxb-replace_me
SLACK_SIGNING_SECRET=replace_me
SLACK_APPROVAL_CHANNEL_ID=C0123456789

# LINE sending. Prefer LINE_HARNESS_SEND_URL if your harness exposes one.
LINE_HARNESS_SEND_URL=
LINE_HARNESS_API_KEY=
LINE_SEND_DRY_RUN=false
# Optional: DB is the source of truth; these only mirror workflow state tags into LINE Harness for operators.
LINE_HARNESS_TAG_SYNC_ENABLED=false
LINE_HARNESS_TAG_SYNC_URL=
LINE_CHANNEL_ACCESS_TOKEN=replace_me
LINE_CHANNEL_SECRET=replace_me

# Google Sheets operator ledger. SHEETS_DRY_RUN=true prevents production writes.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEETS_COLUMN_MAP_JSON=
SHEETS_DRY_RUN=true
# Backward-compatible alias for writeback-only dry-runs.
SHEETS_WRITE_DRY_RUN=true
POST_PARTICIPATION_RESPONSES_SPREADSHEET_ID=
POST_PARTICIPATION_RESPONSES_TAB_NAME=
POST_PARTICIPATION_RESPONSE_COLUMN_MAP_JSON=
BANK_ACCOUNT_RESPONSES_SPREADSHEET_ID=
BANK_ACCOUNT_RESPONSES_TAB_NAME=
BANK_ACCOUNT_RESPONSE_COLUMN_MAP_JSON=

# Application workflow settings.
POST_PARTICIPATION_FORM_URL=
BANK_ACCOUNT_FORM_URL=
WORKFLOW_TIMEZONE=Asia/Tokyo
SAME_DAY_REMINDER_OFFSET_HOURS=2
POST_FORM_DELAY_HOURS=2

# Optional: OpenClaw draft endpoint. If empty, local safe heuristic draft is used.
OPENCLAW_AGENT_URL=
OPENCLAW_AGENT_TOKEN=
OPENCLAW_MODEL_NAME=openclaw

# Optional: protects local admin endpoints for knowledge/monthly-rule setup.
ADMIN_API_KEY=replace_me
